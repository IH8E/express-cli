{
  "name": "@ih8e/express-cli",
  "version": "0.1.4",
  "description": "CLI/TUI/MCP client for eXpress Chat",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "express-cli": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "start": "node ./dist/index.js",
    "setup": "npm run build && npm link && echo '' && echo '✓ Готово — команда express-cli установлена глобально.' && echo '  Дальше:  express-cli auth qr'"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@noble/curves": "2.2.0",
    "@noble/ed25519": "3.1.0",
    "@noble/hashes": "2.2.0",
    "chalk": "5.6.2",
    "cli-table3": "0.6.5",
    "commander": "12.1.0",
    "conf": "13.1.0",
    "ink": "6.8.0",
    "ink-text-input": "6.0.0",
    "inquirer": "9.3.8",
    "libsodium-wrappers-sumo": "0.8.4",
    "qrcode-terminal": "0.12.0",
    "react": "19.2.7",
    "terminal-image": "5.0.1",
    "tweetnacl": "1.0.3",
    "ws": "8.21.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/inquirer": "9.0.10",
    "@types/node": "22.20.1",
    "@types/qrcode-terminal": "0.12.2",
    "@types/react": "19.2.17",
    "@types/ws": "8.18.1",
    "ink-testing-library": "4.0.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
