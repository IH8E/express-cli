    "@noble/hashes": "^2.2.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "ink": "^7.1.0",
    "ink-text-input": "^6.0.0",
    "inquirer": "^9.3.7",
    "libsodium-wrappers-sumo": "^0.8.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.7",
    "terminal-image": "^5.0.1",
