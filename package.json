{
  "name": "@ih8e/express-cli",
  "version": "0.1.2",
  "description": "CLI/TUI/MCP client for eXpress Chat",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "express-cli": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
